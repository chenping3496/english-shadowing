# ============================================================
# 部署到 CloudStudio（或其他云）时，复制本文件为 .env.local 并填入密钥：
#   cp env.example .env.local
# 本文件不含任何真实密钥，可安全提交到 Git。
# ============================================================

# ---------- 阿里云百炼 DashScope（拍照识物 / 视觉识别）----------
# 获取：阿里云百炼控制台 https://bailian.console.aliyun.com -> API-KEY -> 创建（sk- 开头）
VISION_API_KEY=sk-在这里粘贴你的key

# 以下两项有代码默认值，通常无需改：
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# ---------- Bilibili（素材下载 / 播放 / 转写）-----------------
# 获取：浏览器登录 bilibili.com -> F12 开发者工具 -> Application -> Cookies
#       找到 SESSDATA 和 buvid3 两个 Cookie，把值填到下面：
BILI_SESSDATA=在这里粘贴SESSDATA的值
BILI_BUVID3=在这里粘贴buvid3的值

# ---------- TTS 语音合成（可选，有默认值）---------------------
# 默认 cosyvoice-v3-flash / longanyang，需要自定义时取消注释：
# TTS_MODEL=cosyvoice-v3-flash
# TTS_VOICE=longanyang
