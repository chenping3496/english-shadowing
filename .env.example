# 拍照识物 · 视觉 API（OpenAI 兼容，默认阿里通义千问）
# 复制本文件为 .env.local 并填入你的 key，重启 dev server 生效。
# 未配置时，拍照识物会返回「未配置视觉 API key」的友好提示。

# 视觉 API key（阿里 DashScope 的 sk-...，或字节火山方舟的 ark key）
VISION_API_KEY=

# OpenAI 兼容端点（默认阿里；字节火山方舟改为 https://ark.cn-beijing.volces.com/api/v3）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型 ID（默认 qwen-vl-max；字节豆包可改 doubao-seed-2-0-mini-260428 等）
VISION_MODEL=qwen-vl-max


# Bilibili 字幕导入（可选）
# B 站字幕接口要求登录，需要你的 SESSDATA cookie。
# 获取方式：浏览器登录 bilibili.com → F12 → Application → Cookies → bilibili.com → SESSDATA 复制值。
BILI_SESSDATA=

# 可选，通常配合 SESSDATA 一起提供（同处 Cookies 里的 buvid3）
BILI_BUVID3=

# 服务端 SQLite 数据库文件路径（可选，默认 data/shadowing.db）
DATABASE_PATH=


# 共享素材视频存储（默认本地磁盘 data/uploads，几十人规模够用）
# 生产切腾讯云 COS：STORAGE_DRIVER=cos，先 npm i cos-nodejs-sdk-v5，再配下面 4 项
STORAGE_DRIVER=

# 本地存储目录（可选，默认 data/uploads）
UPLOAD_DIR=

# 腾讯云 COS（STORAGE_DRIVER=cos 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# COS 对象前缀（可选，默认 shared/）
COS_PREFIX=
